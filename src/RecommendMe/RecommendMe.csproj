<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>RecommendMe</AssemblyName>
    <RootNamespace>RecommendMe</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Version>0.1.0.2</Version>
    <Nullable>annotations</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DeployPlugin Condition="'$(DeployPlugin)' == ''">true</DeployPlugin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="thumb.png">
      <LogicalName>$(RootNamespace).thumb.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="DeployPluginToEmby" AfterTargets="Build" Condition="'$(DeployPlugin)' == 'true'">
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(APPDATA)\Emby-Server\programdata\plugins"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
